<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.shopify.nrf27.dotgrid" ExtensionBundleVersion="1.0.0" ExtensionBundleName="NRF27 Dot Grid"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.shopify.nrf27.dotgrid.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[25.0,99.9]" />
      <Host Name="IDSN" Version="[17.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0" /></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.shopify.nrf27.dotgrid.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine><Parameter>--allow-file-access-from-files</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>NRF27 Dot Grid</Menu>
          <Geometry>
            <Size><Height>760</Height><Width>320</Width></Size>
            <MinSize><Height>420</Height><Width>280</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>600</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-dark.png</Icon>
            <Icon Type="RollOver">./icons/icon-dark.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-light.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-light.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
